# syntax=docker/dockerfile:1
#
# PRODUCTION image — compiles TypeScript and runs the compiled `dist/server.js`.
# The sibling `Dockerfile` is the DEV image: it installs deps to /deps, expects source
# bind-mounted at /app, and runs ts-node-dev. It never compiles. Keep both —
# docker-compose.yml uses the dev one, Dokploy builds this one.

# node:22-bookworm-slim ships npm 10.x, but package-lock.json is generated locally by
# npm 11. Mismatched majors read nested optional deps differently and `npm ci` fails with
# "lock file's X does not satisfy Y". Pin npm to the major that writes the lockfile.
FROM node:22-bookworm-slim AS base
RUN npm install -g npm@11 --no-audit --no-fund

# ---- build: full deps (needs devDeps for tsc), compile TS -> dist ----
FROM base AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

# ---- prod-deps: runtime dependencies only, no devDeps ----
FROM base AS prod-deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# ---- runtime: no npm, no source, no devDeps — just node + dist ----
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
# config/index.ts defaults PORT to 3001; pin it here so the listen port and EXPOSE
# below can never drift apart. Dokploy's port mapping targets this.
ENV PORT=5000
# All four node-cron schedules use the container's local timezone. Without TZ the
# container is UTC, so AUTO_GENERATION_CRON="0 6 * * *" fires at noon Dhaka time.
ENV TZ=Asia/Dhaka
WORKDIR /app
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build     /app/dist         ./dist
COPY package.json ./
USER node
EXPOSE 5000

# Liveness from inside the container, so an orchestrator restarts a process that is listening but
# has lost Mongo or Redis — /health returns 503 in exactly that case, which a plain TCP check on the
# port would report as healthy.
#
# `node -e` with global fetch rather than curl or wget: neither is in the slim image, and installing
# one to check a health endpoint means shipping an extra package (and its CVE surface) into
# production for the sake of one HTTP call node can already make.
# start-period exceeds this app's own worst case: server.ts bounds verifyConnections() alone at 25s,
# on top of the mongoose connect and seeding that precede it — a cold Atlas connect can land past
# 20s, and a tighter window would kill a container that was merely still starting.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||5000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Exec form, not `npm start` — node runs as PID 1 and receives SIGTERM directly, so
# Dokploy's graceful shutdown reaches the server.close() handler in src/server.ts.
CMD ["node", "dist/server.js"]
