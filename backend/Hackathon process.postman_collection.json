  "item": [
    {
      "name": "Auth",
      "description": "Login and current-user session. Self-registration was removed — only admins create accounts (see Users folder).",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{url}}/auth/login",
              "host": [
                "{{url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in the seed admin (created via `npm run seed:admin -- admin@growthstudio.test ChangeMe123! 'Studio Admin'`). Sets {{token}} for subsequent requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@growthstudio.test\",\n  \"password\": \"ChangeMe123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const result = pm.response.json();",
                  "if (result?.data?.token) {",
                  "    pm.collectionVariables.set('token', result.data.token);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ]
        },
        {
          "name": "Login as Super Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{url}}/auth/login",
              "host": [
                "{{url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in the super_admin. This account is auto-seeded on every server start from `SUPER_ADMIN_EMAIL`/`SUPER_ADMIN_PASSWORD` in `.env` (see `app/lib/seedSuperAdmin.ts`) — no manual setup needed. Required for the Platform Catalog folder (only a super_admin can curate it). Sets {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@gmail.com\",\n  \"password\": \"superadmin123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const result = pm.response.json();",
                  "if (result?.data?.token) {",
                  "    pm.collectionVariables.set('token', result.data.token);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ]
        },
        {
