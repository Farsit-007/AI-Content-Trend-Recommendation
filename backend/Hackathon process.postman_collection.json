    {
      "name": "Platform Catalog",
      "description": "super_admin-curated list of platforms that exist in the system at all (create/enable/disable/delete, all super_admin only). GET is open to any authenticated user — a super_admin sees every entry (incl. disabled, for management); everyone else only sees is_enabled:true ones, i.e. what's currently available for their team to turn on. A team can't enable — and therefore can't add a credential for — a platform that either doesn't exist here or is globally disabled.",
      "item": [
        {
          "name": "Create Platform (super_admin only) — Facebook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{url}}/platforms",
              "host": [
                "{{url}}"
              ],
              "path": [
                "platforms"
              ]
            },
            "description": "Run \"Login as Super Admin\" first. `is_enabled` defaults to true if omitted.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"facebook\",\n  \"label\": \"Facebook\",\n  \"is_enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Create Platform (super_admin only) — Reddit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{url}}/platforms",
              "host": [
                "{{url}}"
              ],
              "path": [
                "platforms"
              ]
            },
            "description": "Demonstrates the catalog is not limited to facebook/youtube/linkedin — any lowercase slug works.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"reddit\",\n  \"label\": \"Reddit\",\n  \"is_enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "List Platforms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url}}/platforms",
              "host": [
                "{{url}}"
              ],
              "path": [
                "platforms"
              ]
            },
            "description": "super_admin sees every catalog entry (incl. disabled); any other role only sees is_enabled:true ones."
          },
          "response": []
        },
        {
          "name": "Enable Platform Globally (super_admin only)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{url}}/platforms/{{platform}}/enable",
              "host": [
                "{{url}}"
              ],
              "path": [
                "platforms",
                "{{platform}}",
                "enable"
              ]
            },
            "description": "Flips the platform's global switch back on — every team that already had it enabled on their side regains access immediately, no action needed from them."
          },
          "response": []
        },
        {
          "name": "Disable Platform Globally (super_admin only)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{url}}/platforms/{{platform}}/disable",
              "host": [
                "{{url}}"
              ],
              "path": [
                "platforms",
                "{{platform}}",
                "disable"
              ]
            },
            "description": "Immediately blocks every team from using this platform — credential submission and token resolution both stop working, even for teams that already had it enabled — until a super_admin re-enables it."
          },
          "response": []
        },
        {
          "name": "Delete Platform (super_admin only)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{url}}/platforms/{{platform}}",
              "host": [
                "{{url}}"
              ],
              "path": [
                "platforms",
                "{{platform}}"
              ]
            },
            "description": "Removes the platform from the catalog entirely and cascades to remove every team's enablement row for it."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Team Platforms",
      "description": "Each team's own on/off switch for a catalog platform. A team can only enable a platform that a super_admin has added to the catalog AND left globally enabled — otherwise this returns 400. Team members (of that team) or admins/super_admins can toggle these.",
      "item": [
        {
          "name": "List Team's Platforms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url}}/teams/{{teamId}}/platforms",
              "host": [
                "{{url}}"
              ],
              "path": [
                "teams",
                "{{teamId}}",
                "platforms"
              ]
            },
            "description": "Every globally-enabled catalog platform, each annotated with whether this specific team currently has it enabled (team_enabled: true/false)."
          },
          "response": []
        },
        {
          "name": "Enable Platform for Team",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{url}}/teams/{{teamId}}/platforms/{{platform}}/enable",
              "host": [
                "{{url}}"
              ],
              "path": [
                "teams",
                "{{teamId}}",
                "platforms",
                "{{platform}}",
                "enable"
              ]
            },
            "description": "Run \"Create Platform\" + \"Enable Platform Globally\" (Platform Catalog folder) first — this 400s if the platform isn't in the catalog or isn't globally enabled. Once enabled here, the team can submit a credential for it (see Platform Credentials folder)."
          },
          "response": []
        },
        {
          "name": "Disable Platform for Team",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{url}}/teams/{{teamId}}/platforms/{{platform}}/disable",
              "host": [
                "{{url}}"
              ],
              "path": [
                "teams",
                "{{teamId}}",
                "platforms",
                "{{platform}}",
                "disable"
              ]
            },
            "description": "A team can always turn its own switch off, regardless of the platform's current global state."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Platform Credentials",
      "description": "Encrypted, team-scoped social platform credentials — any platform a team uses (Facebook, YouTube, LinkedIn, Reddit, Twitter/X, Instagram, TikTok, etc.), not a fixed list. Tokens are AES-256-GCM encrypted at rest; list views only ever show a masked `token_last4`. Only team members (of that team) or admins can access these. **Prerequisite:** run the Platform Catalog + Team Platforms folders first — a team must have the platform enabled (both globally and on the team's own switch) before it can submit a credential for it, or this 400s.",
      "item": [
        {
          "name": "Save/Rotate Platform Credential (Facebook)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{url}}/teams/{{teamId}}/credentials",
              "host": [
                "{{url}}"
              ],
              "path": [
                "teams",
                "{{teamId}}",
                "credentials"
              ]
            },
            "description": "Upserts by (team, platform) — submitting again for the same platform rotates the stored token in place. Requires the team to have enabled \"facebook\" first (Team Platforms folder).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"facebook\",\n  \"token\": \"EAABsbCS1example...redacted...token\",\n  \"account_id\": \"1234567890\"\n}",
              "options": {
                "raw": {
