    {
      "name": "Users",
      "description": "Admin-only account management. There is no public self-registration — every account is created deliberately by an admin, with a role and (usually) a team assignment. Roles: user, admin, super_admin.",
      "item": [
        {
          "name": "Create User (admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{url}}/users",
              "host": [
                "{{url}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Requires an admin bearer token. `role` defaults to \"user\" if omitted; `team_ids` is optional. Run \"Create Team\" first to populate {{teamId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member@growthstudio.test\",\n  \"password\": \"ChangeMe123!\",\n  \"name\": \"Nadia Rahman\",\n  \"role\": \"user\",\n  \"team_ids\": [\n    \"{{teamId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const result = pm.response.json();",
                  "const id = result?.data?._id;",
                  "if (id) { pm.collectionVariables.set('userId', id); }"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ]
        },
        {
          "name": "Create Admin User (admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{url}}/users",
              "host": [
                "{{url}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Admins can create other admins. An admin does not need a team_ids assignment — admins see every team regardless of membership.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"second-admin@growthstudio.test\",\n  \"password\": \"ChangeMe123!\",\n  \"name\": \"Second Admin\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Create Super Admin User (super_admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{url}}/users",
              "host": [
                "{{url}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Escalation guard: creating a user with role \"super_admin\" requires the *caller* to already be a super_admin — a regular admin gets 403 here. Run \"Login as Super Admin\" first.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"second-super-admin@growthstudio.test\",\n  \"password\": \"ChangeMe123!\",\n  \"name\": \"Second Super Admin\",\n  \"role\": \"super_admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "List Users (admin only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{url}}/users?team_id={{teamId}}",
              "host": [
                "{{url}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "team_id",
                  "value": "{{teamId}}",
                  "disabled": true
                }
              ]
            },
            "description": "Lists every user. Pass `?team_id=<id>` to see only one team's roster."
          },
          "response": []
        }
      ]
    },
