# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.

# ---- Core (required — the server will not boot without these) ----
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:5173

DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL_STANDARD=meta-llama/llama-3.1-8b-instruct
LLM_MODEL_CONTENT=meta-llama/llama-3.1-8b-instruct
LLM_MODEL_FALLBACK=google/gemma-2-9b-it:free
EMBEDDING_MODEL=openai/text-embedding-3-small

# ---- Auth (required) ----
# Any long random string. Generate: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Refresh tokens (optional). If JWT_REFRESH_SECRET is unset it falls back to JWT_SECRET —
# safe because the token_type claim keeps access and refresh tokens non-interchangeable,
# but a separate secret is still recommended in production.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ---- Logging (optional) ----
# pino level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# Must decode to EXACTLY 32 bytes (AES-256-GCM). Generate: openssl rand -base64 32
# Losing this key makes every stored platform credential permanently undecryptable.
CREDENTIAL_ENCRYPTION_KEY=change-me-openssl-rand-base64-32

# ---- Super admin (optional — if unset, no account is auto-seeded) ----
# On every server start, if no user with this email exists yet, one is created with
# role: super_admin (see app/lib/seedSuperAdmin.ts). Safe to leave set permanently —
# it's a no-op once the account exists, and existing accounts are never overwritten.
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=superadmin123456
SUPER_ADMIN_NAME=Super Admin

# ---- Platform credentials (all optional — the server boots without them) ----
# Owner: Mursalin (page admin, not on the dev team).
#
# Two independent ways to authenticate, in priority order:
#   1. OAuth (*_CLIENT_ID / *_CLIENT_SECRET) — users connect their own accounts
#   2. Bootstrap tokens (FB_PAGE_TOKEN / YOUTUBE_API_KEY / LINKEDIN_TOKEN) — hand-generated
# The analytics changes work with EITHER. Bootstrap tokens alone are enough.

# Base URL the OAuth callbacks redirect back to. Must match EXACTLY what is
# registered on each provider's app, in every environment.
#   Register: <OAUTH_REDIRECT_BASE_URL>/credentials/facebook/callback   (and /youtube, /linkedin)
OAUTH_REDIRECT_BASE_URL=http://localhost:3001/api/v1

# Facebook / Meta Graph API
# Scopes: pages_read_engagement, pages_show_list, read_insights
FB_CLIENT_ID=
FB_CLIENT_SECRET=
FB_PAGE_TOKEN=
FB_PAGE_ID=

# YouTube Data API v3
# YOUTUBE_API_KEY alone is sufficient for the analytics endpoints — OAuth optional.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# LinkedIn — approval takes 2-3 days and may not arrive before demo.
# Leaving these blank is a supported state: LinkedIn degrades to "pending approval".
# Scopes: r_organization_social, r_basicprofile
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_TOKEN=
LINKEDIN_ORG_ID=

# ---- News ingestion (all optional — server boots with none set) ----
# Pipeline: backend/src/app/modules/NewsIngestion/. Runs on NEWS_INGESTION_CRON
# and via POST /api/v1/news-items/ingest (admin only).

# Comma-separated RSS feed URLs. Unset/empty = the RSS adapter fetches nothing.
# Each item is labeled `rss:<hostname>` (e.g. rss:techcrunch.com) so per-feed
# health is visible in the ingestion summary. The Medium tag feeds below are
# Medium's official RSS endpoints — this is how Medium content enters the
# pipeline; there is no dedicated Medium adapter.
#
# Capped at 25 feeds (currently 21) — every fetched item costs one embedding
# call and a share of an LLM categorization batch, so feed count is a direct
# cost lever, not just a coverage one. The 5 GitHub Releases feeds below all
# share the single `rss:github.com` label by design (labels are hostname-only
# and are a content_hash input — do not extend feedLabel to include paths, or
# every already-stored RSS item silently re-ingests as a duplicate). The arXiv
# entry is one combined query, not one feed per category, satisfying arXiv's
# ~1-request/3s usage policy regardless of how many categories are of interest
# (widen `search_query` instead of adding a second arXiv URL).
NEWS_INGESTION_RSS_FEEDS=https://techcrunch.com/feed/,https://www.theverge.com/rss/index.xml,https://feeds.arstechnica.com/arstechnica/index,https://www.wired.com/feed/rss,https://hnrss.org/frontpage,https://medium.com/feed/tag/artificial-intelligence,https://medium.com/feed/tag/programming,https://medium.com/feed/tag/technology,https://feed.infoq.com/,https://thenewstack.io/feed/,https://www.smashingmagazine.com/feed/,https://stackoverflow.blog/feed/,https://blog.cloudflare.com/rss/,https://changelog.com/feed,https://www.technologyreview.com/feed/,https://github.com/facebook/react/releases.atom,https://github.com/vercel/next.js/releases.atom,https://github.com/nodejs/node/releases.atom,https://github.com/microsoft/typescript/releases.atom,https://github.com/tailwindlabs/tailwindcss/releases.atom,http://export.arxiv.org/api/query?search_query=cat:cs.AI&sortBy=submittedDate&sortOrder=descending&max_results=25

# Items older than this are dropped before scoring. Items with no reliable
# published date (e.g. GitHub Trending) are treated as fresh regardless.
NEWS_INGESTION_MAX_AGE_HOURS=72

# Minimum relevance score (0-10, cosine similarity vs pooled brand-voice
# examples scaled up) an item must reach to survive. Skipped entirely while
# no BrandVoiceExample documents exist yet (cold start).
NEWS_INGESTION_MIN_RELEVANCE=4.0

# Cosine similarity (0-1) at/above which two items are treated as the same
# story and deduped. Live-calibrated against EMBEDDING_MODEL
# (openai/text-embedding-3-small) — do not change casually. Changing this
# value or EMBEDDING_MODEL invalidates the calibration; re-run
# `npm run verify:semantic-dedup-live` after either change.
NEWS_INGESTION_SEMANTIC_DEDUP_THRESHOLD=0.88

# Standard 5-field cron expression for the scheduled ingestion run.
NEWS_INGESTION_CRON=0 */3 * * *

# Comma-separated subreddit names (no r/ prefix) polled by the Reddit adapter.
REDDIT_SUBREDDITS=programming,technology,artificial

# Reddit blocks unauthenticated scripted access with HTTP 403 — the adapter authenticates
# via OAuth2 client-credentials (application-only auth, no Reddit account password involved).
# Both are optional: unset, the adapter logs a warning and returns zero items instead of
# hitting the network, and the server still boots fine.
#
# One-time setup: register a "script"-type app at https://www.reddit.com/prefs/apps
# (any redirect URI, e.g. http://localhost:3001) to get the client id (shown under the
# app name) and secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent identifying the app and its operator, e.g.
# "web:growth-studio-news:v1.0 (by /u/<the-registering-account>)".
REDDIT_USER_AGENT=web:growth-studio-news:v1.0

# GitHub Trending supplements its page scrape with the GitHub Search API (recently-created,
# popular repos). Unauthenticated calls are capped at 10/min, 60/hr — fine at this pipeline's
# call volume. Optional: set a personal access token (no scopes needed for public search) to
# raise that ceiling.
GITHUB_TOKEN=

# Comma-separated Mastodon instance hostnames whose public trending-links
# endpoint (no auth needed) is polled each run. Default-enabled — unlike
# Reddit/GitHub above there are no credentials to configure. Set to an empty
# value to disable the adapter entirely (it will report itself "not
# configured" in run history rather than silently fetching nothing).
NEWS_INGESTION_MASTODON_INSTANCES=mastodon.social,fosstodon.org

# Product Hunt API v2 OAuth2 client-credentials app (top daily launches).
# Both optional: unset, the adapter reports itself unconfigured and the
# server still boots fine.
#
# One-time setup: register a "script"-style application at
# https://www.producthunt.com/v2/oauth/applications (any redirect URI works,
# e.g. http://localhost:3001) to get the client id and secret.
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=

# Stack Exchange API key — optional, raises the unauthenticated rate limit
# (300 req/day per IP -> 10k req/day). The stackoverflow adapter works fine
# without it at this pipeline's call volume (1 request/run). Obtain one by
# registering an app at https://stackapps.com/apps/oauth/register.
STACKEXCHANGE_KEY=

# GNews.io (https://gnews.io) — third-party news-search API. Both optional:
# unset either one and the adapter reports itself unconfigured, server still
# boots fine. Free tier: 100 requests/day; this pipeline uses at most
# 3 topics/run x 8 runs/day = 24/day. Sign up at https://gnews.io to get a
# key (dashboard shows it immediately, no separate app-registration step).
GNEWS_API_KEY=
# Comma-separated search topics (e.g. "AI regulation,React"), at most 3 used
# per run.
NEWS_INGESTION_GNEWS_QUERIES=

# Below this LLM category-confidence score (0-1), a stored item is flagged
# needs_review: true instead of being trusted outright.
NEWS_INGESTION_CATEGORY_CONFIDENCE_THRESHOLD=0.6

# Opportunity-score weights (relevance/trend/audience-fit). MUST sum to
# exactly 1 — enforced at startup (backend/src/app/config/index.ts) and the
# server will refuse to boot if they don't.
NEWS_INGESTION_OPPORTUNITY_WEIGHT_RELEVANCE=0.4
NEWS_INGESTION_OPPORTUNITY_WEIGHT_TREND=0.3
NEWS_INGESTION_OPPORTUNITY_WEIGHT_FIT=0.3

# Relevance value substituted into the opportunity-score formula for runs
# where relevance filtering was skipped (cold start, no brand-voice examples).
NEWS_INGESTION_OPPORTUNITY_FALLBACK_RELEVANCE=5.0
