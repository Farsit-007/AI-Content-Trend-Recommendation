# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.

# ---- Core (required — the server will not boot without these) ----
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:5173

DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# ---- LLM providers: configured in-app, not via env ----
# Sign in as super admin → LLM settings to add providers, API keys, models, and per-task
# defaults. Keys are stored AES-256-GCM-encrypted in Mongo (CREDENTIAL_ENCRYPTION_KEY below).
# The legacy OPENROUTER_API_KEY / LLM_MODEL_* / EMBEDDING_MODEL env vars are no longer part of
# runtime configuration (`.env.test` still sets them for the mocked Jest suite only).

# ---- Auth (required) ----
# Any long random string. Generate: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Refresh tokens (optional). If JWT_REFRESH_SECRET is unset it falls back to JWT_SECRET —
# safe because the token_type claim keeps access and refresh tokens non-interchangeable,
# but a separate secret is still recommended in production.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ---- Credential encryption (required) ----
# AES-256-GCM key for encrypting stored secrets (LLM provider API keys, etc.).
# Generate via: openssl rand -base64 32  (must decode to exactly 32 bytes; base64 or hex accepted)
CREDENTIAL_ENCRYPTION_KEY=

# ---- Logging (optional) ----
# pino level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# ---- Super admin (optional — if unset, no account is auto-seeded) ----
# On every server start, if no user with this email exists yet, one is created with
# role: super_admin (see app/lib/seedSuperAdmin.ts). Safe to leave set permanently —
# it's a no-op once the account exists, and existing accounts are never overwritten.
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=superadmin123456
SUPER_ADMIN_NAME=Super Admin

# ---- News ingestion (all optional — server boots with none set) ----
# Pipeline: backend/src/app/modules/NewsIngestion/. Runs on NEWS_INGESTION_CRON
# and via POST /api/v1/news-items/ingest (admin only).

# Comma-separated RSS feed URLs. Unset/empty = the RSS adapter fetches nothing.
# Each item is labeled `rss:<hostname>` (e.g. rss:techcrunch.com) so per-feed
# health is visible in the ingestion summary. The Medium tag feeds below are
# Medium's official RSS endpoints — this is how Medium content enters the
# pipeline; there is no dedicated Medium adapter.
#
# Capped at 25 feeds (currently 21) — every fetched item costs one embedding
# call and a share of an LLM categorization batch, so feed count is a direct
# cost lever, not just a coverage one. The 5 GitHub Releases feeds below all
# share the single `rss:github.com` label by design (labels are hostname-only
# and are a content_hash input — do not extend feedLabel to include paths, or
# every already-stored RSS item silently re-ingests as a duplicate). The arXiv
# entry is one combined query, not one feed per category, satisfying arXiv's
# ~1-request/3s usage policy regardless of how many categories are of interest
# (widen `search_query` instead of adding a second arXiv URL).
NEWS_INGESTION_RSS_FEEDS=https://techcrunch.com/feed/,https://www.theverge.com/rss/index.xml,https://feeds.arstechnica.com/arstechnica/index,https://www.wired.com/feed/rss,https://hnrss.org/frontpage,https://medium.com/feed/tag/artificial-intelligence,https://medium.com/feed/tag/programming,https://medium.com/feed/tag/technology,https://feed.infoq.com/,https://thenewstack.io/feed/,https://www.smashingmagazine.com/feed/,https://stackoverflow.blog/feed/,https://blog.cloudflare.com/rss/,https://changelog.com/feed,https://www.technologyreview.com/feed/,https://github.com/facebook/react/releases.atom,https://github.com/vercel/next.js/releases.atom,https://github.com/nodejs/node/releases.atom,https://github.com/microsoft/typescript/releases.atom,https://github.com/tailwindlabs/tailwindcss/releases.atom,http://export.arxiv.org/api/query?search_query=cat:cs.AI&sortBy=submittedDate&sortOrder=descending&max_results=25

# Items older than this are dropped before scoring. Items with no reliable
# published date (e.g. GitHub Trending) are treated as fresh regardless.
NEWS_INGESTION_MAX_AGE_HOURS=72

# Kill switch + tuning for the link-page content-enrichment layer (dev.to/GitHub APIs +
# generic article extraction). Enabled by default — every failure mode there is soft.
NEWS_CONTENT_MAX_CHARS=20000
NEWS_CONTENT_FETCH_ENABLED=true
NEWS_CONTENT_FETCH_TIMEOUT_MS=10000
NEWS_CONTENT_FETCH_CONCURRENCY=3

# Minimum relevance score (0-10, cosine similarity vs pooled brand-voice examples scaled up) an
# item must reach to be worth a full-content network fetch (Layer 3b) — NOT a storage gate; every
# deduped item is stored regardless (see flexible-news-taxonomy-and-relevance). Skipped entirely
# while no BrandVoiceExample documents exist yet (cold start — everything gets enriched).
NEWS_CONTENT_FETCH_MIN_RELEVANCE=4.0

# Cosine similarity (0-1) at/above which two items are treated as the same
# story and deduped. Live-calibrated against EMBEDDING_MODEL
# (openai/text-embedding-3-small) — do not change casually. Changing this
# value or EMBEDDING_MODEL invalidates the calibration; re-run
# `npm run verify:semantic-dedup-live` after either change.
NEWS_INGESTION_SEMANTIC_DEDUP_THRESHOLD=0.88

# Two-band dedup (D2) hard-duplicate ceiling. At/above this cosine similarity a
# candidate is dropped as a near-verbatim duplicate WITHOUT an LLM call; between
# the semantic threshold and this ceiling it is adjudicated by the LLM judge.
# Calibrated — measured value from `npm run verify:dedup-calibrate` (max
# update-class similarity + 0.005 margin). Must be greater than the semantic
# threshold. Re-run the calibration harness before changing this or EMBEDDING_MODEL.
NEWS_INGESTION_HARD_DUP_THRESHOLD=0.9443
# Max LLM adjudication batches (10 gray pairs each) per ingestion run — a cost
# bound. Pairs beyond the cap are kept with needs_review, never dropped.
NEWS_INGESTION_ADJUDICATION_MAX_BATCHES=5

# Standard 5-field cron expression for the scheduled ingestion run.
NEWS_INGESTION_CRON=0 */3 * * *

# Comma-separated subreddit names (no r/ prefix) polled by the Reddit adapter.
REDDIT_SUBREDDITS=programming,technology,artificial

# Reddit blocks unauthenticated scripted access with HTTP 403 — the adapter authenticates
# via OAuth2 client-credentials (application-only auth, no Reddit account password involved).
# Both are optional: unset, the adapter logs a warning and returns zero items instead of
# hitting the network, and the server still boots fine.
#
# One-time setup: register a "script"-type app at https://www.reddit.com/prefs/apps
# (any redirect URI, e.g. http://localhost:3001) to get the client id (shown under the
# app name) and secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent identifying the app and its operator, e.g.
# "web:growth-studio-news:v1.0 (by /u/<the-registering-account>)".
REDDIT_USER_AGENT=web:growth-studio-news:v1.0

# GitHub Trending supplements its page scrape with the GitHub Search API (recently-created,
# popular repos). Unauthenticated calls are capped at 10/min, 60/hr — fine at this pipeline's
# call volume. Optional: set a personal access token (no scopes needed for public search) to
# raise that ceiling.
GITHUB_TOKEN=

# Comma-separated Mastodon instance hostnames whose public trending-links
# endpoint (no auth needed) is polled each run. Default-enabled — unlike
# Reddit/GitHub above there are no credentials to configure. Set to an empty
# value to disable the adapter entirely (it will report itself "not
# configured" in run history rather than silently fetching nothing).
NEWS_INGESTION_MASTODON_INSTANCES=mastodon.social,fosstodon.org

# Product Hunt API v2 OAuth2 client-credentials app (top daily launches).
# Both optional: unset, the adapter reports itself unconfigured and the
# server still boots fine.
#
# One-time setup: register a "script"-style application at
# https://www.producthunt.com/v2/oauth/applications (any redirect URI works,
# e.g. http://localhost:3001) to get the client id and secret.
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=

# Stack Exchange API key — optional, raises the unauthenticated rate limit
# (300 req/day per IP -> 10k req/day). The stackoverflow adapter works fine
# without it at this pipeline's call volume (1 request/run). Obtain one by
# registering an app at https://stackapps.com/apps/oauth/register.
STACKEXCHANGE_KEY=

# GNews.io (https://gnews.io) — third-party news-search API. Both optional:
# unset either one and the adapter reports itself unconfigured, server still
# boots fine. Free tier: 100 requests/day; this pipeline uses at most
# 3 topics/run x 8 runs/day = 24/day. Sign up at https://gnews.io to get a
# key (dashboard shows it immediately, no separate app-registration step).
GNEWS_API_KEY=
# Comma-separated search topics (e.g. "AI regulation,React"), at most 3 used
# per run.
NEWS_INGESTION_GNEWS_QUERIES=

# Below this LLM category-confidence score (0-1), a stored item is flagged
# needs_review: true instead of being trusted outright.
NEWS_INGESTION_CATEGORY_CONFIDENCE_THRESHOLD=0.6

# Opportunity-score weights (relevance/trend/audience-fit). MUST sum to
# exactly 1 — enforced at startup (backend/src/app/config/index.ts) and the
# server will refuse to boot if they don't.
NEWS_INGESTION_OPPORTUNITY_WEIGHT_RELEVANCE=0.4
NEWS_INGESTION_OPPORTUNITY_WEIGHT_TREND=0.3
NEWS_INGESTION_OPPORTUNITY_WEIGHT_FIT=0.3

# Relevance value substituted into the opportunity-score formula for runs
# where relevance filtering was skipped (cold start, no brand-voice examples).
NEWS_INGESTION_OPPORTUNITY_FALLBACK_RELEVANCE=5.0

# ---- Content generation (all optional — server boots with defaults) ----
# Interactive generation is always fresh — no response cache/TTL to configure (see
# generation-cache-rework). facts-then-write fact-sheet extraction thresholds:
CONTENT_FACTS_MIN_CHARS=800
CONTENT_FACTS_INPUT_MAX_CHARS=12000

# Optional second-pass critique-and-rewrite step (contentGeneration.critique.ts) that lightly edits
# AI-sounding sentences in a text-format draft, guided by the resolved style pack's card. OFF BY
# DEFAULT — do not flip this to true from a hunch. Enabling it doubles latency/cost for every
# critiqued format; the decision to enable it should come from real paired evidence
# (`npm run verify:bangla-bakeoff -- --critique both`) recorded in BANGLA-QUALITY-DECISION.md, not
# a guess. No-op when false, when no style pack resolves, or for youtube_idea/refine (never eligible).
CONTENT_CRITIQUE_ENABLED=false
# Comma-separated FormatId list — only these text-kind formats run the pass when enabled.
CONTENT_CRITIQUE_FORMATS=facebook_post,linkedin_post

# ---- Style packs (optional — server boots with defaults) ----
# Ready-but-inactive fallback for "Gate G1" — whether text-embedding-3-small ranks Bangla style
# examples sensibly against (often English-leaning) topic queries — a check that has never actually
# been run/recorded (see 9-VISION-V7-V9-WRITER-STYLE-QUALITY-OPENSPEC-PLAN.md and
# BANGLA-QUALITY-DECISION.md). When true, new style examples are embedded from an LLM-extracted
# English topic summary instead of their raw content (stylePack.embeddingStrategy.ts). Do NOT
# enable this without a recorded G1 verdict showing retrieval quality actually needs it — it's a
# fix for a problem nobody has confirmed exists yet.
STYLE_EXAMPLE_EMBED_BY_TOPIC_SUMMARY=false

# ---- News feed semantic match (optional — server boots with defaults) ----
# Ready-but-inactive "nearly relevant" tier layered on top of the always-on exact/broad-group
# category match (see flexible-news-taxonomy-and-relevance). Uses Atlas Vector Search
# ($vectorSearch) against `news_items_vector_index` — Atlas-only infrastructure. Do NOT enable
# without first confirming that index actually exists on this deployment's cluster
# (`npm run db:verify-indexes`); a missing index makes every lookup fail (harmlessly — it's wrapped
# in a try/catch and falls back to exact/group results only — but pointless until confirmed).
# NEWS_FEED_SEMANTIC_MATCH_THRESHOLD is on $vectorSearch's own normalized `vectorSearchScore` scale,
# not raw cosine similarity — tune against real data once enabled.
NEWS_FEED_SEMANTIC_MATCH_ENABLED=false
NEWS_FEED_SEMANTIC_MATCH_THRESHOLD=0.75

# ---- Chat context retrieval (optional — server boots with defaults) ----
# Recency+lifecycle candidate pool for fetchNewsContext, ranked purely by semantic similarity
# (no trend-score pre-filter). See chat-retrieval-topical-coverage.
CHAT_CONTEXT_WINDOW_DAYS=7
CHAT_CONTEXT_POOL_CAP=500
CHAT_CONTEXT_LOW_RELEVANCE_THRESHOLD=0.3

# ---- Auto-generation job (optional — server boots with defaults) ----
AUTO_GENERATION_CRON=0 6 * * *
AUTO_GENERATION_MAX_PER_RUN=10
AUTO_GENERATION_MAX_AGE_HOURS=72
# ---- Engagement refresh job (all optional — server boots with none set) ----
# Re-polls stored news items' engagement (points/comments/stars_delta) from sources
# with a registered fetcher (hackernews, reddit, devto). Never touches trend_score.
# See backend/src/app/modules/NewsRefresh/.

# Standard 5-field cron expression for the scheduled refresh run. Offset from
# NEWS_INGESTION_CRON (0 */3 * * *) so the two jobs never stack.
NEWS_REFRESH_CRON=30 * * * *

# Only items created within this many hours ago are eligible for re-fetch.
NEWS_REFRESH_WINDOW_HOURS=96

# Upper bound on HTTP requests issued to source APIs per run. Candidates are
# walked youngest-first, so older items degrade gracefully once the cap is hit.
NEWS_REFRESH_MAX_REQUESTS=200

# Decay half-life-ish constant (hours) for the live current_trend_score: score decays
# by a factor of exp(-age_hours / TAU). Recomputed at ingest and on every refresh touch.
NEWS_TREND_DECAY_TAU_HOURS=36

# Multiplier on the log-scaled velocity term (rising engagement between the last two
# engagement_history snapshots) added on top of the decayed base score.
NEWS_TREND_VELOCITY_BONUS=2

# How many days a deleted item's content_hash keeps blocking re-ingestion of the same
# URL (news_dedup_ledger TTL). NOTE: changing this after the index already exists in a
# deployed MongoDB does NOT retroactively update that live index — Mongo requires an
# explicit collMod (or dropping/recreating the index) to pick up a new value.
NEWS_DEDUP_LEDGER_TTL_DAYS=30

# ---- News retention lifecycle (all optional — server boots with none set) ----
# Two-stage lifecycle: reversible archive at the "3-4 days" ceiling or on trend
# collapse, then hard delete after a cooling-off window. See NewsRetention/.

# Standard 5-field cron for the retention job.
NEWS_RETENTION_CRON=15 */6 * * *

# Hard ceiling: an active item older than this (by created_at) is archived
# regardless of score. This is the "3-4 days" requirement's outer bound.
NEWS_ARCHIVE_MAX_AGE_HOURS=96

# Grace period: an item younger than this is never archived on the trend floor,
# only on the max-age ceiling above. Must be less than NEWS_ARCHIVE_MAX_AGE_HOURS.
NEWS_ARCHIVE_MIN_AGE_HOURS=36

# current_trend_score below this (after the min-age grace period, and only for
# items with an engagement signal) triggers a trend_floor archive — the
# "immediately when out of trend" half of the requirement. Must be in [0, 10].
NEWS_ARCHIVE_TREND_FLOOR=2.0

# Days an item stays archived (restorable) before the retention job hard-deletes
# it with cascade (tombstone + category-override cleanup). Must be >= 1.
NEWS_DELETE_AFTER_DAYS=14

# ---- Analytics adapters ----
# Master switch: 'true' (default) forces ALL platforms to mock data (also the test default).
# Set 'false' to allow real adapters — but only for platforms in ANALYTICS_REAL_PLATFORMS.
ANALYTICS_USE_MOCK_ADAPTERS=true
# Comma-separated allowlist of platforms that use their REAL adapter when the switch is off.
# facebook + instagram have working Graph adapters; linkedin has an org adapter that returns
# "pending approval" until the Community Management API product is approved. youtube stays mock.
ANALYTICS_REAL_PLATFORMS=facebook,instagram,linkedin
# Meta Graph API version — single upgrade point for every Graph call.
GRAPH_API_VERSION=v25.0
