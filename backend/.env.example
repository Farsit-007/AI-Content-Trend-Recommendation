# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.

# ---- Core (required — the server will not boot without these) ----
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

DATABASE_URL=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL_STANDARD=meta-llama/llama-3.1-8b-instruct
LLM_MODEL_CONTENT=meta-llama/llama-3.1-8b-instruct
LLM_MODEL_FALLBACK=google/gemma-2-9b-it:free
EMBEDDING_MODEL=openai/text-embedding-3-small

# ---- Auth (required) ----
# Any long random string. Generate: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Must decode to EXACTLY 32 bytes (AES-256-GCM). Generate: openssl rand -base64 32
# Losing this key makes every stored platform credential permanently undecryptable.
CREDENTIAL_ENCRYPTION_KEY=change-me-openssl-rand-base64-32

# ---- Platform credentials (all optional — the server boots without them) ----
# Owner: Mursalin (page admin, not on the dev team).
#
# Two independent ways to authenticate, in priority order:
#   1. OAuth (*_CLIENT_ID / *_CLIENT_SECRET) — users connect their own accounts
#   2. Bootstrap tokens (FB_PAGE_TOKEN / YOUTUBE_API_KEY / LINKEDIN_TOKEN) — hand-generated
# The analytics changes work with EITHER. Bootstrap tokens alone are enough.

# Base URL the OAuth callbacks redirect back to. Must match EXACTLY what is
# registered on each provider's app, in every environment.
#   Register: <OAUTH_REDIRECT_BASE_URL>/credentials/facebook/callback   (and /youtube, /linkedin)
OAUTH_REDIRECT_BASE_URL=http://localhost:3001/api/v1

# Facebook / Meta Graph API
# Scopes: pages_read_engagement, pages_show_list, read_insights
FB_CLIENT_ID=
FB_CLIENT_SECRET=
FB_PAGE_TOKEN=
FB_PAGE_ID=

# YouTube Data API v3
# YOUTUBE_API_KEY alone is sufficient for the analytics endpoints — OAuth optional.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# LinkedIn — approval takes 2-3 days and may not arrive before demo.
# Leaving these blank is a supported state: LinkedIn degrades to "pending approval".
# Scopes: r_organization_social, r_basicprofile
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_TOKEN=
LINKEDIN_ORG_ID=
