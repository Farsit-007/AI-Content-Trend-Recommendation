# Test-only environment. Loaded by src/__tests__/support/loadTestEnv.ts before config/index.ts runs
# its eager zod parse, so the suite gets schema-valid values without touching the real .env.
#
# Every value here is a throwaway placeholder and is meant to be committed — nothing in this file is
# a real credential, and CI cannot run without it. Do not put real secrets here.

NODE_ENV=test
PORT=3001

# Overridden per-suite by mongodb-memory-server; this only has to satisfy the schema.
DATABASE_URL=mongodb://127.0.0.1:27017/growth_studio_test
# jest.config.ts maps ioredis -> ioredis-mock, so nothing connects to this.
REDIS_URL=redis://localhost:6379

JWT_SECRET=test-jwt-secret-value-not-a-real-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=test-refresh-secret-value-not-real
JWT_REFRESH_EXPIRES_IN=30d

# 32 zero bytes, base64. Placeholder only — see config/index.ts for the real key's requirements.
CREDENTIAL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

LOG_LEVEL=silent

# Legacy bootstrap tier. Present so model resolution has a deterministic terminal fallback in the
# mocked suite instead of throwing LlmNotConfiguredError; all provider calls are mocked regardless.
OPENROUTER_API_KEY=test-openrouter-key
LLM_MODEL_STANDARD=test/standard-model
LLM_MODEL_CONTENT=test/content-model
LLM_MODEL_FALLBACK=test/fallback-model
EMBEDDING_MODEL=test/embedding-model

# Off for tests: several suites issue dozens of requests (and many failed logins) from one address,
# which is the assertion, not abuse.
RATE_LIMIT_ENABLED=false

# Unset on purpose — the mailer must report itself unconfigured so no suite attempts SMTP.
# SMTP_HOST=
