# Test-only environment values for `npm test` (Jest integration suite).
# None of these are real secrets — DATABASE_URL/REDIS_URL are placeholders because tests
# use mongodb-memory-server and ioredis-mock instead of connecting to these URLs, and
# OPENROUTER_API_KEY is never used because the OpenRouter client is mocked in every test.
# Safe to commit. Do not reuse any of these values outside of the test suite.

NODE_ENV=test
PORT=3001
WEB_URL=http://localhost:3000

DATABASE_URL=mongodb://127.0.0.1:27017/growth-studio-test-placeholder
REDIS_URL=redis://127.0.0.1:6379/1

OPENROUTER_API_KEY=test-placeholder-openrouter-key
LLM_MODEL_STANDARD=test-standard-model
LLM_MODEL_CONTENT=test-content-model
LLM_MODEL_FALLBACK=test-fallback-model
EMBEDDING_MODEL=test-embedding-model

JWT_SECRET=test-only-jwt-secret-do-not-use-in-prod
JWT_EXPIRES_IN=1h

CREDENTIAL_ENCRYPTION_KEY=8aZyVxjCEWWdroHgXIkuix8numkw0f9N4t1WDHDUuz0=
