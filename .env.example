# Copy this file to backend/.env and fill in the values.
# docker-compose reads backend/.env directly.

# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# Database
# (Docker Compose overrides this to use the mongodb service)
# ==========================================
DATABASE_URL=mongodb://localhost:27017/growth_studio

# ==========================================
# Redis
# (Docker Compose overrides this to use the redis service)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# JWT
# ==========================================
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# ==========================================
# Cloudinary
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# SMTP / Email
# ==========================================
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_app_password

# ==========================================
# Frontend URL (for CORS)
# ==========================================
WEB_URL=http://localhost:3000
