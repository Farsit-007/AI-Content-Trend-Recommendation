# Copy this file to backend/.env and fill in the values.
# docker-compose reads backend/.env directly.

# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# Database — MongoDB Atlas M0 (required for $vectorSearch; a local
# mongo:7-jammy image does NOT support it — see MASTER-PLAN.md critical fix #1)
# ==========================================
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/growth_studio?retryWrites=true&w=majority

# ==========================================
# Redis
# (Docker Compose overrides this to use the redis service)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# OpenRouter — LLM (models verified free & working 2026-07-13; OpenRouter's
# catalog changes — re-verify with a curl call if these start 404ing)
# ==========================================
OPENROUTER_API_KEY=your_openrouter_api_key
LLM_MODEL_STANDARD=openai/gpt-oss-20b:free
LLM_MODEL_CONTENT=openai/gpt-oss-120b:free
LLM_MODEL_FALLBACK=nvidia/nemotron-nano-9b-v2:free

# ==========================================
# Embeddings — OpenRouter (nomic-ai/nomic-embed-text is not served on
# OpenRouter's /embeddings endpoint; openai/text-embedding-3-small is
# verified live and working — see MASTER-PLAN.md critical fix #2)
# ==========================================
EMBEDDING_MODEL=openai/text-embedding-3-small

# ==========================================
# Frontend URL (for CORS)
# ==========================================
WEB_URL=http://localhost:3000
