# Template for backend/.env — copy it there and fill in your own values.
#
# Every value below is a PLACEHOLDER. Never commit a real credential to this file: it is tracked in
# git, so anything pasted here is permanently in the repository's history even after it is removed.

# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=5000

# Number of reverse proxies in front of the server, for Express's `trust proxy`. Rate limiting is
# IP-keyed, so this matters: 0 behind a proxy means every user shares one bucket, and >0 with no
# proxy lets a client spoof X-Forwarded-For for a fresh bucket per request. Set to 1 on Dokploy.
TRUST_PROXY_HOPS=0

# ==========================================
# Database — MongoDB Atlas is required. Atlas Vector Search does not exist on a local
# mongo image, which is why docker-compose.yml deliberately runs no mongo service.
# ==========================================
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/growth_studio?appName=Cluster0

# ==========================================
# Redis (Docker Compose overrides this to the in-network service name)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# LLM providers — configured in-app, NOT here.
# Sign in as super admin -> AI Providers to add providers, API keys (stored AES-256-GCM-encrypted in
# Mongo via CREDENTIAL_ENCRYPTION_KEY), models, and per-task defaults. The old OPENROUTER_API_KEY /
# LLM_MODEL_* / EMBEDDING_MODEL vars remain only as a legacy bootstrap tier for the test suite;
# leave them unset in a real deployment so a misconfiguration fails loudly instead of falling back
# to static env credentials. See app/lib/modelResolution.ts.
# ==========================================

# ==========================================
# Frontend origin, for the CORS allowlist. localhost:5173 and :3000 are always allowed.
# ==========================================
WEB_URL=http://localhost:5173

# ==========================================
# Auth — generate your own: `openssl rand -hex 32`
# ==========================================
JWT_SECRET=replace-me-with-at-least-16-random-characters
JWT_EXPIRES_IN=7d
# Optional — falls back to JWT_SECRET when unset.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# AES-256-GCM key encrypting every stored LLM provider API key. The highest-value secret in the
# system. Must decode to exactly 32 bytes (base64 or hex): `openssl rand -base64 32`.
# Rotating it requires re-encrypting the keys already stored in Mongo.
CREDENTIAL_ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32

# pino level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ==========================================
# Error tracking (app/lib/errorReporting.ts). Unset = disabled, every reporting call a no-op.
# Reports 5xx responses, unhandled rejections, uncaught exceptions and failed cron runs.
# ==========================================
SENTRY_DSN=
# Performance tracing is a separate cost decision from "tell me when the API 500s".
SENTRY_TRACES_SAMPLE_RATE=0

# ==========================================
# Outbound mail — password-reset delivery (app/lib/mailer.ts). With SMTP_HOST unset the mailer
# reports itself unconfigured and forgotPassword logs the reset link instead of emailing it, which
# means a locked-out user has no self-serve recovery path. Set these in production.
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ==========================================
# Rate limiting (app/middleware/rateLimit.ts). Windows in minutes, maxes per window.
# RATE_LIMIT_LLM_* is the per-team daily budget on the endpoints that spend provider credits.
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=1
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_LLM_WINDOW_MINUTES=1440
RATE_LIMIT_LLM_MAX=200

# ==========================================
# Super admin — auto-seeded on server start if this email doesn't already exist
# (see app/lib/seedSuperAdmin.ts). Choose a real password; this account can reveal provider keys.
# ==========================================
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

# ==========================================
# News ingestion — every var below is optional and defaulted in app/config/index.ts, which
# documents the reasoning behind each. Only set one to deviate from the default.
# ==========================================
NEWS_INGESTION_MAX_AGE_HOURS=72
NEWS_CONTENT_MAX_CHARS=20000
NEWS_CONTENT_FETCH_ENABLED=true
NEWS_CONTENT_FETCH_TIMEOUT_MS=10000
NEWS_CONTENT_FETCH_CONCURRENCY=3
NEWS_CONTENT_FETCH_MIN_RELEVANCE=4.0
NEWS_INGESTION_SEMANTIC_DEDUP_THRESHOLD=0.88
# Calibrated — re-run `npm run verify:dedup-calibrate` before changing.
NEWS_INGESTION_HARD_DUP_THRESHOLD=0.9443
NEWS_INGESTION_ADJUDICATION_MAX_BATCHES=5
# Runaway backstop on Layer 4's LLM spend. Items over the cap are still stored, with the fallback
# category and needs_review — never dropped.
NEWS_INGESTION_MAX_CATEGORIZE_ITEMS=400
NEWS_INGESTION_CRON=0 */3 * * *
NEWS_INGESTION_MASTODON_INSTANCES=mastodon.social,fosstodon.org
NEWS_INGESTION_CATEGORY_CONFIDENCE_THRESHOLD=0.6
# These three must sum to exactly 1 or the server refuses to boot.
NEWS_INGESTION_OPPORTUNITY_WEIGHT_RELEVANCE=0.4
NEWS_INGESTION_OPPORTUNITY_WEIGHT_TREND=0.3
NEWS_INGESTION_OPPORTUNITY_WEIGHT_FIT=0.3
NEWS_INGESTION_OPPORTUNITY_FALLBACK_RELEVANCE=5.0

# Optional source credentials. Each only raises a rate limit or enables a source — without them the
# adapter reports itself unconfigured and the run continues.
# GITHUB_TOKEN needs no scopes: https://github.com/settings/tokens
GITHUB_TOKEN=
STACKEXCHANGE_KEY=
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=

# ==========================================
# Chat — Atlas Vector Search for context retrieval. Off by default: it needs
# news_items_vector_index to exist WITH `lifecycle` and `created_at` declared as filter fields.
# Verify with `npm run db:verify-indexes`, and re-run `npm run db:create-indexes` if the index
# predates those filter fields. Failure is soft — chat falls back to the in-memory pool.
# ==========================================
CHAT_VECTOR_SEARCH_ENABLED=false

# ==========================================
# Content generation
# ==========================================
CONTENT_FACTS_MIN_CHARS=800
CONTENT_FACTS_INPUT_MAX_CHARS=12000

# ==========================================
# Auto-generation job
# ==========================================
AUTO_GENERATION_CRON=0 6 * * *
AUTO_GENERATION_MAX_PER_RUN=10
AUTO_GENERATION_MAX_AGE_HOURS=72
