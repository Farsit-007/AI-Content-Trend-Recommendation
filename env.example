# ==========================================
# Application
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# Database — MongoDB Atlas M0 (required for $vectorSearch; a local
# mongo:7-jammy image does NOT support it — see MASTER-PLAN.md critical fix #1)
# ==========================================
DATABASE_URL=mongodb+srv://saminisrar1_db_user:gCT7WBvy8DPewmy9@cluster0.xuultiq.mongodb.net/growth_studio?appName=Cluster0

# ==========================================
# Redis
# (Docker Compose overrides this to use the redis service)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# LLM providers — configured in-app, NOT here.
# Sign in as super admin → LLM settings to add providers, API keys (stored
# AES-256-GCM-encrypted in Mongo via CREDENTIAL_ENCRYPTION_KEY), models, and
# per-task defaults. The old OPENROUTER_API_KEY / LLM_MODEL_* / EMBEDDING_MODEL
# env vars are gone from runtime config; see modelResolution.ts.
# ==========================================

# ==========================================
# Frontend URL (for CORS)
# ==========================================
WEB_URL=http://localhost:3000

JWT_SECRET=3f029f83086f902b532277458941d7794264046aa43e3647
JWT_EXPIRES_IN=7d
# Optional — falls back to JWT_SECRET when unset.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# AES-256-GCM key for encrypting stored secrets (LLM provider API keys, etc.) — generate via
# `openssl rand -base64 32`. Must decode to exactly 32 bytes (base64 or hex accepted).
CREDENTIAL_ENCRYPTION_KEY=JOxUJiRiZnTjTdJOktlrmdra7qw9+xbIGtYWwThyad8=

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ==========================================
# Super admin — auto-seeded on server start if this email doesn't already exist
# (see app/lib/seedSuperAdmin.ts)
# ==========================================
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=superadmin123456
SUPER_ADMIN_NAME=Super Admin

# ==========================================
# News ingestion — see .env.example for full documentation of every var
# ==========================================
NEWS_INGESTION_MAX_AGE_HOURS=72
NEWS_CONTENT_MAX_CHARS=20000
NEWS_CONTENT_FETCH_ENABLED=true
NEWS_CONTENT_FETCH_TIMEOUT_MS=10000
NEWS_CONTENT_FETCH_CONCURRENCY=3
NEWS_CONTENT_FETCH_MIN_RELEVANCE=4.0
NEWS_INGESTION_SEMANTIC_DEDUP_THRESHOLD=0.88
NEWS_INGESTION_CRON=0 */3 * * *
NEWS_INGESTION_MASTODON_INSTANCES=mastodon.social,fosstodon.org
NEWS_INGESTION_CATEGORY_CONFIDENCE_THRESHOLD=0.6
NEWS_INGESTION_OPPORTUNITY_WEIGHT_RELEVANCE=0.4
NEWS_INGESTION_OPPORTUNITY_WEIGHT_TREND=0.3
NEWS_INGESTION_OPPORTUNITY_WEIGHT_FIT=0.3
NEWS_INGESTION_OPPORTUNITY_FALLBACK_RELEVANCE=5.0

# Optional — raises the GitHub Search API's unauthenticated rate limit. Generate a fresh
# token at https://github.com/settings/tokens if you want this (no scopes needed).
GITHUB_TOKEN=

STACKEXCHANGE_KEY=

PRODUCTHUNT_CLIENT_ID=4H4kyuOA2yKF1ACm76LWlNKrNrvSzyLeFfIe1Ln9n3Q
PRODUCTHUNT_CLIENT_SECRET=_7lvupEck7aIhhKjiM7yhpaYxQ-4nxPkgnD_bjO7cr4

# ==========================================
# Content generation
# ==========================================
CONTENT_FACTS_MIN_CHARS=800
CONTENT_FACTS_INPUT_MAX_CHARS=12000

# ==========================================
# Auto-generation job
# ==========================================
AUTO_GENERATION_CRON=0 6 * * *
AUTO_GENERATION_MAX_PER_RUN=10
AUTO_GENERATION_MAX_AGE_HOURS=72