# Base URL of the Growth Studio backend REST API (includes the /api/v1 prefix).
VITE_API_URL=http://localhost:5000/api/v1

# Optional: pins the dashboard to one team, bypassing the env-override step of the team
# switcher's resolution order (see src/context/TeamProvider.tsx). Leave unset for normal
# multi-team use — the switcher falls back to stored selection / first membership.
VITE_DEFAULT_TEAM_ID=
