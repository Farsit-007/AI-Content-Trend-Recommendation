{
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(docker:*)",
      "Bash(npx:*)",
      "Bash(pulumi:*)",
      "Bash(ssh:*)",
      "Bash(curl:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(ls:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "git diff --stat HEAD 2>/dev/null | tail -6"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ecc@ecc": true
  }
}
